{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SIJI Public Agent Trace Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "timestamp",
    "public_summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "user",
        "assistant_plan",
        "tool_decision",
        "tool_request",
        "tool_result",
        "assistant_synthesis",
        "stop_decision",
        "report_checkpoint"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "capability": {
      "enum": [
        "Web Search",
        "Web Page",
        "SIJI Research API",
        null
      ]
    },
    "provenance": {
      "enum": [
        "web",
        "siji",
        "agent_analysis",
        "user",
        null
      ]
    },
    "public_summary": {
      "type": "string",
      "minLength": 1
    },
    "request_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "response_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "charged_ru": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    }
  }
}
