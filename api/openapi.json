  "info": {
    "title": "SIJI Research API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/research": {
      "post": {
        "description": "Company, product, industry, comparison and continuous tracking use one account quota.\n\nAPI keys authenticate; quota belongs to the account. A browser may instead\nuse SIJI's existing session + CSRF protection. ResearchRoute admits and\nrate-limits the account before body parsing. Idempotency-Key is optional:\nsame key retries are replayable for 24h, headerless identical requests for\n10min. Research does not initiate a crawl or a new research agent.",
        "operationId": "research_v1_research_post",
        "parameters": [
          {
            "description": "Keep unchanged for retries of one logical request (24h).",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Keep unchanged for retries of one logical request (24h).",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResearchPacket"
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "A bounded JSON or Markdown packet from currently published canonical intelligence."
          },
          "401": {
            "description": "A customer API key or authenticated same-origin browser session is required."
          },
          "402": {
            "description": "Account Research Units are insufficient."
          },
          "403": {
            "description": "Current plan, key status or scope forbids the operation."
          },
          "409": {
            "description": "Idempotency conflict, changed source rights or stale cursor."
          },
          "413": {
            "description": "Request body exceeds 16 KiB."
          },
          "422": {
            "description": "Invalid mode, field selection, identifier or tracking window."
          },
          "429": {
            "description": "Account RPM, concurrency, rolling daily usage or enumeration limit."
          },
          "503": {
            "description": "Dependency, canonical availability or bounded-work failure. No RU charged."
          }
        },
        "security": [
          {
            "ResearchApiKey": []
          }
        ],
        "summary": "Research",
        "tags": [
          "research"
        ]
      }
    }
  }
}
